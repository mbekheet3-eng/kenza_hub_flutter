// ARCHIVED SOURCE FROM SUPABASE V2 (klkcroynomxuajggqqqx)
// Historical reference only. This file is NOT deployed to Marketplace.
// Review schema dependencies and security before any adaptation.

import { createClient } from "npm:@supabase/supabase-js@2";

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "authorization, apikey, content-type",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
};

const json = (body: unknown, status = 200) =>
  new Response(JSON.stringify(body), {
    status,
    headers: { ...corsHeaders, "Content-Type": "application/json" },
  });

Deno.serve(async (req: Request) => {
  if (req.method === "OPTIONS") return new Response("ok", { headers: corsHeaders });
  if (req.method !== "POST") return json({ error: "METHOD_NOT_ALLOWED" }, 405);

  const authHeader = req.headers.get("Authorization");
  const token = authHeader?.startsWith("Bearer ") ? authHeader.slice(7) : null;
  if (!token) return json({ error: "AUTH_REQUIRED" }, 401);

  let secretKey = "";
  try {
    const keys = Deno.env.get("SUPABASE_SECRET_KEYS");
    if (keys) secretKey = JSON.parse(keys).default ?? "";
  } catch { /* fall back to legacy key below */ }
  secretKey ||= Deno.env.get("SUPABASE_SERVICE_ROLE_KEY") ?? "";
  if (!secretKey) return json({ error: "SERVER_CONFIGURATION_ERROR" }, 500);

  const supabase = createClient(
    Deno.env.get("SUPABASE_URL")!,
    secretKey,
    { auth: { persistSession: false, autoRefreshToken: false } },
  );

  try {
    const { data: authData, error: authError } = await supabase.auth.getUser(token);
    const user = authData?.user;
    if (authError || !user) return json({ error: "INVALID_SESSION" }, 401);

    const body = await req.json();
    const imageId = body?.image_id;
    if (typeof imageId !== "string") return json({ error: "IMAGE_ID_REQUIRED" }, 400);

    const { data: image, error: imageError } = await supabase
      .from("product_images")
      .select("id, product_id, image_path, storage_bucket, ai_review_status, ai_review_result")
      .eq("id", imageId)
      .maybeSingle();
    if (imageError || !image) return json({ error: "IMAGE_NOT_FOUND" }, 404);

    const { data: product, error: productError } = await supabase
      .from("products")
      .select("id, seller_id, moderation_status")
      .eq("id", image.product_id)
      .maybeSingle();
    if (productError || !product) return json({ error: "PRODUCT_NOT_FOUND" }, 404);
    if (product.moderation_status !== "pending") {
      return json({ error: "PRODUCT_NOT_PENDING_REVIEW" }, 409);
    }

    const { data: activeUser, error: activeUserError } = await supabase
      .from("users")
      .select("is_active")
      .eq("id", user.id)
      .maybeSingle();
    if (activeUserError || !activeUser?.is_active) {
      return json({ error: "ACTIVE_USER_REQUIRED" }, 403);
    }

    const { data: sellerProfile, error: sellerProfileError } = await supabase
      .from("seller_profiles")
      .select("owner_user_id, is_active")
      .eq("id", product.seller_id)
      .maybeSingle();
    if (sellerProfileError || !sellerProfile?.is_active) {
      return json({ error: "ACTIVE_SELLER_PROFILE_REQUIRED" }, 403);
    }

    let canManageImages = sellerProfile.owner_user_id === user.id;
    if (!canManageImages) {
      const { data: membership, error: membershipError } = await supabase
        .from("seller_profile_members")
        .select("permissions")
        .eq("seller_profile_id", product.seller_id)
        .eq("user_id", user.id)
        .is("revoked_at", null)
        .maybeSingle();
      if (membershipError) {
        console.error("Seller membership lookup failed", membershipError.message);
        return json({ error: "PRODUCT_IMAGE_PERMISSION_CHECK_FAILED" }, 500);
      }
      canManageImages = membership?.permissions?.["products:update"] === true;
    }
    if (!canManageImages) {
      return json({ error: "PRODUCT_IMAGE_PERMISSION_REQUIRED" }, 403);
    }

    // TEMPORARY LAUNCH MODE: Gemini moderation is paused.
    // Keep authentication, active-account, seller ownership/permission, and
    // product-pending checks above. Mark uploaded images approved immediately.
    const temporaryApprovalResult = {
      decision: "approved",
      quality: "not_checked",
      quality_issues: [],
      unsafe_content: false,
      adult_or_sexual_content: false,
      violence_or_gore: false,
      irrelevant_or_misleading: false,
      prohibited_item: false,
      product_visible: true,
      reason_ar: "تم النشر مؤقتًا مع إيقاف مراجعة الصور الآلية",
      confidence: 0,
      temporary_auto_approval: true,
      moderation_skipped: "gemini_paused_for_launch",
    };
    const { error: approvalSaveError } = await supabase
      .from("product_images")
      .update({
        ai_review_status: "approved",
        ai_review_result: temporaryApprovalResult,
        ai_reviewed_at: new Date().toISOString(),
        ai_review_model: "temporary-auto-publish",
      })
      .eq("id", image.id);
    if (approvalSaveError) {
      console.error("Temporary image approval failed", approvalSaveError.message);
      return json({ error: "IMAGE_APPROVAL_SAVE_FAILED" }, 500);
    }

    const { data: imageRows, error: rowsError } = await supabase
      .from("product_images")
      .select("ai_review_status")
      .eq("product_id", product.id);
    if (rowsError || !imageRows?.length) {
      console.error("Could not evaluate product images", rowsError?.message);
      return json({ error: "PRODUCT_IMAGE_STATUS_FAILED" }, 500);
    }

    if (!imageRows.every((row: any) => row.ai_review_status === "approved")) {
      return json({
        image_id: image.id,
        status: "approved",
        decision: "approved",
        product_status: "pending_images",
        moderation_mode: "temporary_auto_publish",
      });
    }

    const { data: availableStatus, error: statusError } = await supabase
      .from("product_statuses")
      .select("id")
      .eq("slug", "available")
      .eq("is_active", true)
      .maybeSingle();
    if (statusError || !availableStatus?.id) {
      console.error("Available product status is missing", statusError?.message);
      return json({ error: "AVAILABLE_STATUS_NOT_CONFIGURED" }, 500);
    }

    const { error: publishError } = await supabase
      .from("products")
      .update({
        moderation_status: "approved",
        status_id: availableStatus.id,
        published_at: new Date().toISOString(),
      })
      .eq("id", product.id)
      .eq("moderation_status", "pending");
    if (publishError) {
      console.error("Temporary product publication failed", publishError.message);
      return json({ error: "PRODUCT_PUBLICATION_FAILED" }, 500);
    }

    return json({
      image_id: image.id,
      status: "approved",
      decision: "approved",
      product_status: "available",
      moderation_mode: "temporary_auto_publish",
      warning: "Gemini image safety and quality checks are temporarily disabled.",
    });
  } catch (error) {
    console.error("Image moderation error", error instanceof Error ? error.message : "unknown");
    return json({ error: "INTERNAL_ERROR" }, 500);
  }
});

